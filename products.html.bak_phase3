<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>상품 카탈로그 · JAY ABO</title>
<meta name="description" content="암웨이 검증 상품 전체 · 카테고리별 필터 · 후원자 준영 추천">
<link rel="stylesheet" href="layout/site.css">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Malgun Gothic','Apple SD Gothic Neo',sans-serif; background: var(--jay-bg); color: var(--jay-text); line-height: 1.6; }
  .container { max-width: 1120px; margin: 0 auto; padding: 30px 20px 40px; }
  .page-title { text-align: center; margin-bottom: 8px; }
  .page-title h1 { font-size: 28px; font-weight: 800; }
  .page-title p { color: var(--jay-muted); margin-top: 6px; }

  .filter-bar {
    display: flex; gap: 8px; flex-wrap: wrap;
    justify-content: center; margin: 26px 0 20px;
  }
  .filter-chip {
    padding: 8px 18px; border: 1px solid var(--jay-border);
    background: #fff; border-radius: 20px; cursor: pointer;
    font-size: 13px; font-weight: 600; transition: all 0.15s;
    color: var(--jay-text); text-decoration: none;
  }
  .filter-chip:hover { border-color: var(--jay-brand); }
  .filter-chip.active { background: var(--jay-brand); color: #fff; border-color: var(--jay-brand); }

  .search-box {
    max-width: 400px; margin: 0 auto 20px;
    position: relative;
  }
  .search-box input {
    width: 100%; padding: 10px 40px 10px 14px;
    border: 1px solid var(--jay-border); border-radius: 10px;
    font-size: 14px; background: #fff;
  }
  .search-box::before {
    content: "🔍"; position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%); pointer-events: none; opacity: 0.4;
  }

  .products-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }
  .product-card {
    background: #fff; border: 1px solid var(--jay-border); border-radius: 12px;
    padding: 14px; text-decoration: none; color: var(--jay-text);
    transition: all 0.15s;
  }
  .product-card:hover { border-color: var(--jay-brand); transform: translateY(-3px); box-shadow: 0 8px 18px rgba(0,40,85,0.08); }
  .product-img {
    width: 100%; aspect-ratio: 1; background: #f0f4f8;
    border-radius: 8px; margin-bottom: 10px; object-fit: cover;
    overflow: hidden;
  }
  .product-img img { width: 100%; height: 100%; object-fit: contain; }
  .product-name { font-size: 13px; font-weight: 600; line-height: 1.4; min-height: 2.8em; }
  .product-price { color: var(--jay-accent); font-weight: 700; font-size: 14px; margin-top: 6px; }
  .product-cat {
    display: inline-block; background: #f0f4f8; color: var(--jay-muted);
    padding: 2px 6px; border-radius: 4px; font-size: 10px; margin-top: 4px;
  }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--jay-muted); }
</style>
</head>
<body>

<div class="container">
  <div class="page-title">
    <h1>상품 카탈로그</h1>
    <p>후원자 준영이 · 카테고리별 검증한 인기 상품</p>
  </div>

  <div class="search-box">
    <input id="search-input" type="text" placeholder="상품명 검색..." oninput="applyFilter()">
  </div>

  <div class="filter-bar" id="filter-bar">
    <a href="#" class="filter-chip active" data-cat="all">전체</a>
    <a href="#" class="filter-chip" data-cat="nutrition">💊 영양건강</a>
    <a href="#" class="filter-chip" data-cat="skin">✨ 스킨케어</a>
    <a href="#" class="filter-chip" data-cat="body">🧴 바디케어</a>
    <a href="#" class="filter-chip" data-cat="home">🏠 주방·가정</a>
  </div>

  <div id="products-grid" class="products-grid"></div>
  <div id="empty-state" class="empty-state" style="display:none">일치하는 상품 없음</div>
</div>

<script src="layout/site.js"></script>
<script>
let ALL = [];
async function loadProducts() {
  try {
    const r = await fetch('products.json');
    if (r.ok) ALL = await r.json();
    else ALL = [];
  } catch(e) {
    console.warn(e);
    ALL = [];
  }
  applyFilter();
}
function categoryOf(p) {
  const name = (p.name || '').toLowerCase();
  const cat = (p.category || '').toLowerCase();
  if (/뉴트리|비타민|오메가|밀크|루테인|프로바이오|칼슘/.test(name)) return 'nutrition';
  if (/아티스트리|립|파운데이션|쿠션|블러쉬|스킨|크림|세럼|마스카라/.test(name)) return 'skin';
  if (/샴푸|바디|치약|린스|글리스터|샤워/.test(name)) return 'body';
  if (/정수|공기청정|주방|프라이팬|쿡웨어|배관|세제/.test(name)) return 'home';
  return 'other';
}
function applyFilter() {
  const params = new URLSearchParams(location.search);
  const urlCat = params.get('cat');
  const chipCat = document.querySelector('.filter-chip.active')?.dataset.cat || 'all';
  const cat = urlCat || chipCat;
  const search = (document.getElementById('search-input')?.value || '').trim().toLowerCase();

  // 검색어가 있으면 · 카테고리 필터 무시하고 · 전체에서 검색 (준영님 요청)
  const effectiveCat = search ? 'all' : cat;

  // URL cat와 chip 싱크
  document.querySelectorAll('.filter-chip').forEach(c => {
    c.classList.toggle('active', c.dataset.cat === cat);
  });

  let filtered = ALL.filter(p => {
    if (effectiveCat && effectiveCat !== 'all' && categoryOf(p) !== effectiveCat) return false;
    if (search && !(p.name || '').toLowerCase().includes(search)) return false;
    return true;
  });

  const grid = document.getElementById('products-grid');
  const empty = document.getElementById('empty-state');
  if (filtered.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  grid.innerHTML = filtered.map(p => `
    <a class="product-card" href="pages/${encodeURIComponent(p.file)}">
      <div class="product-img">${p.image ? `<img src="assets/${p.image}" alt="${p.name}">` : ''}</div>
      <div class="product-name">${p.name || '(이름 없음)'}</div>
      ${p.price ? `<div class="product-price">${p.price.toLocaleString()}원</div>` : ''}
    </a>
  `).join('');
}

document.querySelectorAll('.filter-chip').forEach(c => {
  c.addEventListener('click', (e) => {
    e.preventDefault();
    document.querySelectorAll('.filter-chip').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    // URL 갱신 (히스토리 남기지 않고 replaceState)
    const url = new URL(location.href);
    if (c.dataset.cat === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', c.dataset.cat);
    history.replaceState(null, '', url);
    applyFilter();
  });
});
loadProducts();
</script>
</body>
</html>
